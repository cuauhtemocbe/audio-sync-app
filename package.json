{
    "name": "audio-sync-app",
    "version": "1.1.0",
    "type": "module",
    "packageManager": "pnpm@11.14.0",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "husky || true",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{js,jsx,css,html}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,css,html}\""
    },
    "lint-staged": {
        "*.{js,jsx}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@vitejs/plugin-react": "^6.0.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.0.8",
        "postcss": "^8.5.23",
        "prettier": "^3.9.5",
        "tailwindcss": "^4.3.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
