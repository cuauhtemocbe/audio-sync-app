{
    "name": "audio-sync-app",
    "version": "1.1.0",
    "type": "module",
    "packageManager": "pnpm@11.14.0",
    "engines": {
        "node": ">=26.12.1 <27"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "husky || true",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{js,jsx,css,html}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,css,html}\""
    },
    "lint-staged": {
        "*.{js,jsx}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "express": "^5.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@vitejs/plugin-react": "^6.3.0",
        "@tailwindcss/postcss": "^4.3.5",
        "@vitest/coverage-v8": "^4.1.12",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jsdom": "^31.0.1",
        "lint-staged": "^17.6.1",
        "postcss": "^8.5.33",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "vite": "^8.3.8",
        "vitest": "^4.1.12"
    }
}
